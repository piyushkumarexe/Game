{
  "name": "dustbound-rv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original physics road-trip game for Android and iOS.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:native",
    "build:native": "tsc --noEmit && vite build --base ./ --mode native",
    "sync:native": "npm run build:native && cap sync",
    "android:sync": "npm run build:native && cap sync android",
    "ios:sync": "npm run build:native && cap sync ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
