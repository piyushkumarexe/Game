; Dustbound Expeditions — original mobile co-op physics adventure
; Godot 4.7.2
config_version=5

[application]
config/name="Dustbound Expeditions"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/image="res://assets/ui/roadtrip-hero.png"
boot_splash/bg_color=Color(0.035, 0.047, 0.067, 1)
boot_splash/fullsize=true

[autoload]
GameSession="*res://scripts/core/game_session.gd"
Net="*res://scripts/network/network_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/directional_shadow/size=2048
limits/time/time_rollover_secs=3600.0
environment/defaults/default_clear_color=Color(0.16, 0.22, 0.26, 1)

[physics]
common/physics_ticks_per_second=60
common/physics_jitter_fix=0.5
3d/default_gravity=16.0

[audio]
default_bus_layout="res://default_bus_layout.tres"
driver/enable_input=true

[network]
limits/debugger/max_queued_messages=2048
